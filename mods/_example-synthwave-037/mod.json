{
  "name": "Synthwave 037",
  "version": "1.0.0",
  "author": "macha",
  "description": "example d5ml mod: all three Lancia 037 liveries go synthwave (hue shift + our own star decals), generated from your own game files",
  "generate": [
    {
      "target": "data:textures/vehicles/liveries/lancia_037_livery_0[12].gtx",
      "steps": [
        { "effect": "hue", "amount": 200 },
        { "effect": "saturate", "amount": 1.35 },
        { "effect": "overlay", "image": "stars.png" }
      ]
    },
    {
      "target": "data:textures/vehicles/liveries/lancia_037_livery_03.gtx",
      "steps": [
        { "effect": "hue", "amount": 120 },
        { "effect": "saturate", "amount": 1.35 },
        { "effect": "overlay", "image": "stars.png" }
      ]
    }
  ]
}
